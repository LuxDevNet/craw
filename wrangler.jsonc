{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agnamo-craw",
  "main": "workers/craw-site.js",
  "compatibility_date": "2026-10-30",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 1
    }
  },
  "r2_buckets": [
    {
      "binding": "ASSETS_BUCKET",
      "bucket_name": "agnamo-craw"
    }
  ]
}
